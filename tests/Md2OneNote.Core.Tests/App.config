<?xml version="1.0" encoding="utf-8"?>
<!--
  Present so that MSBuild has somewhere to write the binding redirects the net48 test host needs.
  The redirects themselves are generated; nothing here is hand-maintained.
-->
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" />
  </runtime>
</configuration>
