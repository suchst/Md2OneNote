# Md2OneNote editor settings. See https://editorconfig.org.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = 100

[*.{xml,csproj,props,targets,yml,yaml,json,iss}]
indent_size = 2

[*.ps1]
# PowerShell 5.1 reads a file without a BOM as ANSI; non-ASCII text needs the BOM.
charset = utf-8-bom

[*.cs]
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true
