<?xml version="1.0" encoding="utf-8"?>
<!--
  Bound to idMso="TabInsert", which is a control id rather than a UI string and is therefore the
  same on every language build (NFR-11, DESIGN.md §11).
-->
<!--
  Images come from the loadImage callback, which serves the PNGs embedded under Images/ by the
  id in the image attribute (RibbonImages.cs). Office picks the size it needs.
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" loadImage="LoadImage">
  <ribbon>
    <tabs>
      <tab idMso="TabInsert">
        <group id="Md2OneNoteGroup" label="Markdown">

          <button id="Md2OneNoteImport"
                  label="Import Markdown"
                  size="large"
                  image="Import32"
                  onAction="OnImportClicked"
                  screentip="Import Markdown files as OneNote pages"
                  supertip="Creates one page per selected .md file in the current section." />

          <separator id="Md2OneNoteSeparator" />

          <!-- Icon only, small: the label is the tooltip. A labelled small button next to one
               large button floated alone at the top of an empty column (2026-09-15). -->
          <button id="Md2OneNoteAbout"
                  label="About"
                  showLabel="false"
                  size="normal"
                  image="About32"
                  onAction="OnAboutClicked"
                  screentip="About Md2OneNote"
                  supertip="Version, links, the log folder, and a diagnostic bundle for bug reports." />

        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
