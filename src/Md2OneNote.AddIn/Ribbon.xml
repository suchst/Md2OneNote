<?xml version="1.0" encoding="utf-8"?>
<!--
  Bound to idMso="TabInsert", which is a control id rather than a UI string and is therefore the
  same on every language build (NFR-11, DESIGN.md §11).
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <tab idMso="TabInsert">
        <group id="Md2OneNoteGroup" label="Markdown">

          <button id="Md2OneNoteImport"
                  label="Import Markdown"
                  size="large"
                  imageMso="ImportSavedImports"
                  onAction="OnImportClicked"
                  screentip="Import Markdown files as OneNote pages"
                  supertip="Creates one page per selected .md file in the current section." />

        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
