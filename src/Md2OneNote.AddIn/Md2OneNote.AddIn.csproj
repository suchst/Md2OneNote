<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The class is registered per-user by tools/register.ps1, never by regasm during build:
         registration must not need elevation (IMPLEMENTATION.md §10, NFR-10). -->
    <ComVisible>false</ComVisible>
    <EnableComHosting>false</EnableComHosting>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Md2OneNote.Core\Md2OneNote.Core.csproj" />
    <ProjectReference Include="..\Md2OneNote.Interop\Md2OneNote.Interop.csproj" />
    <ProjectReference Include="..\Md2OneNote.Application\Md2OneNote.Application.csproj" />
    <ProjectReference Include="..\Md2OneNote.Storage\Md2OneNote.Storage.csproj" />
    <ProjectReference Include="..\Md2OneNote.Diagrams\Md2OneNote.Diagrams.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ribbon.xml" />
  </ItemGroup>

</Project>
