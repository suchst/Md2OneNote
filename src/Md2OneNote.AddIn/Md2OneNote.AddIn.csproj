<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Md2OneNote.AddIn</RootNamespace>
    <AssemblyName>Md2OneNote.AddIn</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- AnyCPU is not optional: a 32-bit OneNote will not load a 64-bit add-in, and the reverse
         holds too (IMPLEMENTATION.md §2). -->
    <PlatformTarget>AnyCPU</PlatformTarget>

    <!-- The class is registered per-user by tools/register.ps1, never by regasm during build:
         registration must not need elevation (IMPLEMENTATION.md §10, NFR-10). -->
    <ComVisible>false</ComVisible>
    <EnableComHosting>false</EnableComHosting>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Md2OneNote.Core\Md2OneNote.Core.csproj" />
    <ProjectReference Include="..\Md2OneNote.Interop\Md2OneNote.Interop.csproj" />
    <ProjectReference Include="..\Md2OneNote.Application\Md2OneNote.Application.csproj" />
    <ProjectReference Include="..\Md2OneNote.Storage\Md2OneNote.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ribbon.xml" />
  </ItemGroup>

</Project>
