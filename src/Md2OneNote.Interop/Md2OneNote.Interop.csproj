<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Md2OneNote.Interop</RootNamespace>
    <AssemblyName>Md2OneNote.Interop</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Md2OneNote.Core\Md2OneNote.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hierarchy parsing is the one part of this assembly that runs without OneNote, so it is
         the one part CI can defend. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Md2OneNote.Interop.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
