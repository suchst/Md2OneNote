<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The WebView2 control is a WinForms control; the renderer hosts it on its own STA thread
         with a message loop (IMPLEMENTATION.md §8.2, §13). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned. The SDK's managed wrapper and the native WebView2Loader.dll ship together and
         must match; the Evergreen runtime on the machine is separate and forward-compatible. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Md2OneNote.Core\Md2OneNote.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shell and its libraries are embedded and extracted under %LOCALAPPDATA% at first
         use (ShellFiles). NavigateToString caps at 2 MB and Mermaid alone is 5.5 MB, so the
         shell is served from a folder mapping instead. Every embedded file except the version
         stamps is extracted; the logical name is the path the shell loads it from.
           mermaid.min.js   Mermaid (MIT, Assets/mermaid.LICENSE)
           viz-global.js    Viz.js with Graphviz as WebAssembly (MIT + EPL-1.0, viz.LICENSE,
                            graphviz.LICENSE)
           katex.min.*      KaTeX and its fonts (MIT, katex.LICENSE) -->
    <EmbeddedResource Include="Assets\shell.html" LogicalName="shell.html" />
    <EmbeddedResource Include="Assets\mermaid.min.js" LogicalName="mermaid.min.js" />
    <EmbeddedResource Include="Assets\mermaid.version.txt" LogicalName="mermaid.version.txt" />
    <EmbeddedResource Include="Assets\viz-global.js" LogicalName="viz-global.js" />
    <EmbeddedResource Include="Assets\viz.version.txt" LogicalName="viz.version.txt" />
    <EmbeddedResource Include="Assets\katex.min.js" LogicalName="katex.min.js" />
    <EmbeddedResource Include="Assets\katex.min.css" LogicalName="katex.min.css" />
    <EmbeddedResource Include="Assets\katex.version.txt" LogicalName="katex.version.txt" />
    <EmbeddedResource Include="Assets\fonts\*.woff2" LogicalName="fonts/%(Filename)%(Extension)" />
    <None Include="Assets\mermaid.LICENSE" />
    <None Include="Assets\viz.LICENSE" />
    <None Include="Assets\graphviz.LICENSE" />
    <None Include="Assets\katex.LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Md2OneNote.Diagrams.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
